    (comp (ref "U_ID")   (value "LM74700-Q1") (footprint "Package_TO_SOT_SMD:SOT-23-6")               (description "Ideal-diode controller (reverse battery)"))
    (comp (ref "Q_ID")   (value "IPB019N08N3")(footprint "Package_TO_SOT_SMD:TO-263-3_TabPin2")       (description "N-channel MOSFET, ideal-diode pass element"))
    (comp (ref "TVS1")   (value "5KP24A")     (footprint "Diode_THT:D_DO-201AE_P15.24mm_Horizontal")  (description "Load-dump TVS 24V"))
    (comp (ref "L1")     (value "2.2uH")      (footprint "Inductor_SMD:L_12x12mm")                    (description "Power inductor >=30A sat"))
    (comp (ref "NTC1")   (value "2R5/20A")    (footprint "Resistor_THT:R_Axial_Power")                (description "Inrush NTC (Ametherm SL22 2R5)"))
    (comp (ref "K1")     (value "Relay12V")   (footprint "Relay_THT:Relay_SPST_Generic")              (description "NTC bypass relay"))
    (comp (ref "C_in")   (value "470uF/35V")  (footprint "Capacitor_THT:CP_Radial_D10.0mm_P5.00mm")   (description "Input bulk electrolytic, low-ESR"))
    (comp (ref "C_in2")  (value "1uF")        (footprint "Capacitor_SMD:C_1206_3216Metric")           (description "Input HF ceramic"))

    (comp (ref "R_reg")  (value "470")        (footprint "Resistor_SMD:R_0805_2012Metric")            (description "Series R for 555 zener rail"))
    (comp (ref "Z_reg")  (value "12V")        (footprint "Package_TO_SOT_SMD:SOT-23")                 (description "Zener, 555 rail regulation (BZX84C12)"))
    (comp (ref "C_byp")  (value "100nF")      (footprint "Capacitor_SMD:C_0805_2012Metric")           (description "555 VCC bypass (at pin8)"))
    (comp (ref "U1")     (value "TLC555")     (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm")        (description "CMOS 555 timer, PWM oscillator"))
    (comp (ref "C_ctrl") (value "100nF")      (footprint "Capacitor_SMD:C_0805_2012Metric")           (description "555 CONTROL pin bypass (pin5)"))
    (comp (ref "R1")     (value "1k")         (footprint "Resistor_SMD:R_0805_2012Metric")            (description "555 timing resistor"))
    (comp (ref "Ct")     (value "10nF")       (footprint "Capacitor_SMD:C_0805_2012Metric")           (description "555 timing capacitor (~25kHz)"))
    (comp (ref "Da")     (value "1N4148")     (footprint "Diode_SMD:D_SOD-123")                       (description "Duty-steering diode (charge)"))
    (comp (ref "Db")     (value "1N4148")     (footprint "Diode_SMD:D_SOD-123")                       (description "Duty-steering diode (discharge)"))
    (comp (ref "RV1")    (value "10k")        (footprint "Potentiometer_THT:Potentiometer_Bourns_3296W") (description "Duty-adjust trim pot"))

    (comp (ref "J_EXT")  (value "Conn_3p")    (footprint "Connector_JST:JST_XH_B3B-XH-A_1x03_P2.50mm") (description "External 3-wire: VCC/PWM/GND"))
    (comp (ref "JP_MAIN")(value "Jumper_2p")  (footprint "Connector_PinHeader_2.54mm:PinHeader_1x02_P2.54mm") (description "Main jumper (removed=local live)"))
    (comp (ref "R_pull") (value "100k")       (footprint "Resistor_SMD:R_0805_2012Metric")            (description "RESET/mode pull resistor"))
    (comp (ref "J_MODE") (value "Conn_3p")    (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm") (description "Mode header: pin1=FULL SPEED, centre=GND, pin2=PWM"))
