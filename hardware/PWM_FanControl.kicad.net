    (sheet (number "1") (name "/") (tstamps "/")
      (title_block
        (title "PWM_FanControl - 555 PWM high-side fan controller (MK4 Golf)")
        (company "12V automotive, 300W (~25A), high-side P-ch, heatsink-free")
        (comment (number "1") (value "TC4420 default gate driver (option B). DNF discrete totem pole (Q_p/Q_n) omitted."))
        (comment (number "2") (value "Verify against hardware/PWM_FanControl.net (source of truth)."))
        (comment (number "3") (value "Control: J_MODE pin1=FULL SPEED (QFON force-on + QRST reset interlock), pin2=PWM."))
        (comment (number "4") (value "Unverified starting point: validate load-dump, fan stall current, gate-drive edges before build.")))))

  (components
